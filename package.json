{
  "name": "xinhui-glm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "test": "vitest run",
    "build:web": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "build:server": "tsc -p tsconfig.node.json",
    "build": "npm run build:web && npm run build:server",
    "build:sites": "node scripts/build-sites.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "echarts": "^6.1.0",
    "express": "^5.2.1",
    "@lucide/vue": "^1.28.0",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.11.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
